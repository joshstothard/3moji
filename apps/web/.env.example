# Web app environment variables
# Copy to .env.local and fill in for local development.

# Set by CI/CD via --build-arg; leave as 0.0.0.0 locally
NEXT_PUBLIC_APP_VERSION=0.0.0

# Postgres. The pooled connection for the app; migrations use the unpooled one.
DATABASE_URL=postgresql://app:app@localhost:5432/app_test

# Where the app is served from. Better Auth builds verification and reset links
# from this, so a wrong value produces emails whose links go nowhere. The share
# link a Profile copies (#160) takes its origin from it too.
BETTER_AUTH_URL=http://localhost:3000

# Signing secret, at least 32 random characters. Generate, never invent.
BETTER_AUTH_SECRET=

# Resend. Send from a subdomain so a deliverability problem cannot poison the
# apex domain (ADR-0006 decision 7).
RESEND_API_KEY=
RESEND_FROM=3moji <no-reply@mail.3moji.me>

# Where "Report this page" on every claimed Profile sends its email (#197).
# Optional: unset means no report link is rendered. Must be one plain address
# with nothing else in it; a value carrying a display name, a second address,
# "?", "&", "%" or a line break is refused and the link is omitted. The real
# mailbox is an owner decision (docs/owner-actions.md). Never commit a real one.
REPORT_CONTACT_EMAIL=

# Test-only. Set to "recording" to capture email instead of sending it through
# Resend, as CI's E2E job does. Leave unset everywhere else: the app refuses to
# start with it set when NODE_ENV=production or VERCEL_ENV is present.
# TEST_EMAIL_SENDER=recording
