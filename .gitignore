# Generated by `next dev` / `next build` when a route compiles — not at server
# start, which is why it is easy to miss. Tracking `next-env.d.ts` means every
# checkout that runs the dev server goes dirty, and committing the dev variant
# points CI's typecheck at `.next/dev/types/`, a directory `next build` never
# creates (#69). Next regenerates it, and `tsc --noEmit` passes without it on a
# clean clone with no `.next/` at all — verified before untracking it.
next-env.d.ts

# Next.js 16 writes its own agent instructions into the app directory when a
# route compiles. Anchored to apps/web so the repository's own AGENTS.md and
# CLAUDE.md at the root stay tracked.
/apps/web/AGENTS.md
/apps/web/CLAUDE.md
