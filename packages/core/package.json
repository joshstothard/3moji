{
  "name": "@template/core",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "development": "./src/browser.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage --passWithNoTests",
    "test:integration": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.integration.config.mjs --passWithNoTests"
  },
  "devDependencies": {
    "@template/eslint-config": "*",
    "@template/jest-config": "*",
    "@template/tsconfig": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "fast-check": "^4.10.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
